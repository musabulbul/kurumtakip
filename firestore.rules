rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() && request.auth.token.staff == true;
    }

    function orgBookingEnabled(orgId) {
      return exists(/databases/$(database)/documents/orgs/$(orgId)) &&
        get(/databases/$(database)/documents/orgs/$(orgId)).data.bookingEnabled == true;
    }

    // Slug çözümleme için herkese açık.
    match /orgSlugs/{slug} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Public booking ekranının ihtiyaç duyduğu org alanları okunabilir.
    // Not: Hassas alanlar ayrı dokümanda tutulmalıdır.
    match /orgs/{orgId} {
      allow get: if resource.data.bookingEnabled == true;
      allow list: if false;
      allow write: if isStaff();

      match /services/{serviceId} {
        allow read: if orgBookingEnabled(orgId) && resource.data.active == true;
        allow write: if isStaff();
      }
    }

    match /customers/{customerId} {
      allow read, write: if isStaff();
    }

    // Public istemci doğrudan bookings yazmaz; backend endpoint / function kullanır.
    match /bookings/{bookingId} {
      allow create, update, delete: if false;
      allow read: if isStaff();
    }

    match /bookingLocks/{lockId} {
      allow read, write: if false;
    }
  }
}
